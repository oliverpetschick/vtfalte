  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "maplibre-gl": "^4.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-favicon": "^2.0.7",
    "react-native": "^0.73.6",
    "react-native-web": "^0.19.10",
    "react-router-dom": "^6.22.3",
    "react-scripts": "^5.0.1",
    "styled-components": "^6.1.8",
    "web-vitals": "^2.1.4",
    "webfontloader": "^1.6.28"
